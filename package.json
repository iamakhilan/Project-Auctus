{
  "name": "auctus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "mobile:dev": "node scripts/mobile-dev.mjs",
    "mobile:dev:usb": "node scripts/mobile-dev.mjs --usb",
    "mobile:sync": "npm run build && npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:build": "node scripts/mobile-build.mjs",
    "mobile:build:release": "node scripts/mobile-build.mjs --release"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
